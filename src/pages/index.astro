---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, urlOf, formatDate } from '../lib/posts';
import { SITE_NAME, DESCRIPTION } from '../consts';

const posts = await getPosts();
---

<BaseLayout title={SITE_NAME} description={DESCRIPTION}>
  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <h2 class="post-list__title">
            <a href={urlOf(post)}>{post.data.title}</a>
          </h2>
          <p class="post-list__description">{post.data.description}</p>
          <p class="meta post-list__meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
          </p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
